APP_ENV=development

# Cadena de conexión a PostgreSQL. En docker-compose, el host es "db" (nombre del servicio).
# En ejecución local sin Docker, usa "localhost".
DATABASE_URL=postgresql+psycopg://dash_parking:dash_parking@localhost:5432/dash_parking

# Cambiar este valor en cada entorno real — nunca commitear un secreto real en .env.example.
JWT_SECRET=change-me-in-.env
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Orígenes permitidos para CORS, separados por coma.
CORS_ORIGINS=http://localhost:5173

# URL pública del frontend incluida en los enlaces de recuperación.
FRONTEND_BASE_URL=http://localhost:5173

# Proveedor de correo: smtp para desarrollo local o brevo para HTTPS (por ejemplo, Render Free).
EMAIL_PROVIDER=smtp
EMAIL_TIMEOUT_SECONDS=10

# SMTP para correos reales. Deja los valores vacíos hasta configurar un proveedor.
# Para SMTPS (normalmente puerto 465), activa SMTP_USE_SSL y desactiva SMTP_USE_TLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# API HTTPS de Brevo. Usa el correo remitente verificado en Brevo.
BREVO_API_KEY=
EMAIL_FROM_EMAIL=
EMAIL_FROM_NAME=Dash Parking
