APP_ENV=development

# Cadena de conexión a PostgreSQL. En docker-compose, el host es "db" (nombre del servicio).
# En ejecución local sin Docker, usa "localhost".
DATABASE_URL=postgresql+psycopg://dash_parking:dash_parking@localhost:5432/dash_parking

# Base de disponibilidad por franjas (esquema en español, ver db/README.md).
PARKING_DATABASE_URL=postgresql+psycopg://dash_parking:dash_parking@localhost:5432/dash_parking_v2

# Cambiar este valor en cada entorno real — nunca commitear un secreto real en .env.example.
JWT_SECRET=change-me-in-.env
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Orígenes permitidos para CORS, separados por coma.
CORS_ORIGINS=http://localhost:5173
