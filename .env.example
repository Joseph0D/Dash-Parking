APP_ENV=development

# Cadena de conexión a PostgreSQL. En docker-compose, el host es "db" (nombre del servicio).
# En ejecución local sin Docker, usa "localhost".
DATABASE_URL=postgresql+psycopg://dash_parking:dash_parking@localhost:5432/dash_parking

# Base de disponibilidad por franjas (esquema en español, ver db/README.md).
PARKING_DATABASE_URL=postgresql+psycopg://dash_parking:dash_parking@localhost:5432/dash_parking_v2

# Cambiar este valor en cada entorno real — nunca commitear un secreto real en .env.example.
JWT_SECRET=change-me-in-.env
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Orígenes permitidos para CORS, separados por coma.
CORS_ORIGINS=http://localhost:5173
FRONTEND_BASE_URL=http://localhost:5173

# Correo. En Render Free usa la API HTTPS de Brevo (no SMTP saliente).
EMAIL_PROVIDER=smtp
EMAIL_TIMEOUT_SECONDS=10
BREVO_API_KEY=
EMAIL_FROM_EMAIL=
EMAIL_FROM_NAME=Dash Parking

# SMTP para desarrollo local; las credenciales se configuran solo en .env.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
